{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_sources}",
		"issues": "${mod_issues}"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"cc.avie.daycounter.fabric.DayCounterFabric"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"tabbylib": ">=${tabbylib_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"avie.discord": "https://discord.gg/57TZ8BJvd9"
			}
		}
	}
}
